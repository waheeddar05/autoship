# ClickUp Configuration
CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLICKUP_MY_USER_ID=your-clickup-user-id
CLICKUP_WORKSPACE_ID=your-workspace-id
CLICKUP_LIST_ID=your-list-id
CLICKUP_FOLDER_ID=your-folder-id

# Webhook secret (returned when registering webhook via register-webhook.js)
CLICKUP_WEBHOOK_SECRET=

# GitHub (org used when repo field has no org prefix)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_ORG=your-github-org

# GitHub webhook secret (optional, for PR review automation)
GITHUB_WEBHOOK_SECRET=

# Local repos directory (where repos are cloned)
REPOS_BASE_DIR=/path/to/your/repos

# Server
PORT=3457
NODE_ENV=production
MODE=webhook  # "webhook" only — polling is disabled

# Task trigger statuses (comma-separated, case-insensitive)
# Tasks must be in one of these statuses to trigger automation
TRIGGER_STATUSES=backlog,ready,to do,open,todo,planning

# Claude Code
CLAUDE_CODE_PATH=claude
MAX_CONCURRENT_SESSIONS=1
CLAUDE_TIMEOUT_MS=1800000

# Google OAuth (required for authentication)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Session
SESSION_SECRET=replace-with-a-long-random-string

# Auth settings
BASE_URL=http://localhost:3457
ALLOWED_DOMAIN=your-domain.com
ADMIN_EMAIL=admin@your-domain.com
ADMIN_NAME=Admin

# ClickUp OAuth (per-user integration)
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=http://localhost:3457/api/integrations/clickup/callback

# GitHub OAuth (per-user integration — separate from GITHUB_TOKEN)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3457/api/integrations/github/callback

# Token encryption key for OAuth tokens at rest (generate with: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=

# Optional: Slack
# SLACK_CHANNEL_ID=C0123456789
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── New feature knobs (all also editable in the dashboard Settings) ──

# Live budget enforcement: kill a Claude run past this estimated spend (0 = off)
# LIVE_BUDGET_USD=0

# Non-blocking self-review: scores below the threshold open the PR as a draft
# SELF_REVIEW_ENABLED=true
# SELF_REVIEW_DRAFT_THRESHOLD=70
# SELF_REVIEW_MODEL=anthropic:claude-sonnet-4-6

# Task decomposition: complex tasks run as sequential subtask passes
# TASK_DECOMPOSITION_ENABLED=false

# Clarifying questions instead of hard rejection for low-quality tickets
# CLARIFYING_QUESTIONS_ENABLED=true
# CLARIFICATION_MAX_ROUNDS=1

# GitHub Issues as a task source: label an issue to trigger AutoShip
# GITHUB_ISSUES_ENABLED=false
# GITHUB_ISSUES_REPOS=acme/webapp,acme/api
# GITHUB_ISSUES_LABEL=autoship

# Slack task intake: @mention the bot to draft tasks (needs Events API + bot token)
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_INTAKE_LIST_ID=901234567
# SLACK_INTAKE_MODEL=anthropic:claude-sonnet-4-6

# Slack assistant (Slash-style): @mention to ask codebase questions, debug
# incidents from stack traces, review specs, and trigger PR reviews.
# Build requests still flow through task intake (draft → buttons → PR).
# SLACK_ASSISTANT_ENABLED=true
# ASSISTANT_MODEL=anthropic:claude-sonnet-4-6
# ASSISTANT_INTENT_MODEL=anthropic:claude-haiku-4-5-20251001
# ASSISTANT_DEFAULT_REPO=acme/webapp
# ASSISTANT_MAX_CONTEXT_TOKENS=6000
# ClickUp list (inside your tracking folder) for assistant-created tasks.
# Empty = reuse SLACK_INTAKE_LIST_ID.
# ASSISTANT_TASK_LIST_ID=

# Assistant repo scope: restrict the assistant to a GitHub team's repos.
# Needs GITHUB_TOKEN with read:org scope + team access. Team repos are fetched
# live and cached, so the allowlist tracks repos added/removed from the team.
# ASSISTANT_REPO_SCOPE_ENABLED=true
# ASSISTANT_TEAM_ORG=sarasanalytics-com
# ASSISTANT_TEAM_SLUG=daton
# ASSISTANT_ALLOWED_REPOS_STATIC=          # extra always-allowed org/repo,comma-separated
# ASSISTANT_REPO_SCOPE_CACHE_MS=600000

# Review every PR: post an in-depth AI review on every PR opened in
# webhook-registered repos (human-authored PRs included)
# REVIEW_EVERY_PR_ENABLED=false
# PR_REVIEW_MODEL=anthropic:claude-sonnet-4-6
# PR_REVIEW_SKIP_DRAFTS=true
# PR_REVIEW_ON_SYNC=false
# PR_REVIEW_POST_COMMENT=true

# Visual verification: Playwright screenshots on frontend PRs
# VISUAL_VERIFICATION_ENABLED=false
# VISUAL_VERIFICATION_ROUTES=/,/login

# Failure post-mortem classification model
# FAILURE_ANALYSIS_MODEL=anthropic:claude-haiku-4-5-20251001

# Stale task cleanup interval
# STALE_CLEANUP_INTERVAL_MS=1800000

# Auto-merge AutoShip PRs when a reviewer approves
# AUTO_MERGE_ON_APPROVAL=false
